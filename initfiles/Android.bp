install_symlink {
    name: "eks2_symlink",
    vendor: true,
    installed_location: "app/eks2/eks2.dat",
    symlink_target: "/data/vendor/eks2/eks2.dat",
}

sh_binary {
    name: "hazeldos-ctrl",
    filename: "hazeldos-ctrl",
    src: "hazeldos-ctrl",
    soc_specific: true,
}

sh_binary {
    name: "lkm_loader_target",
    filename: "lkm_loader_target.sh",
    src: "lkm_loader_target.sh",
    soc_specific: true,
}
